---
layout: base.njk
title: "Truth Access Technology"
description: "Truth Access Technology — wiki, use cases and frequently asked questions."
---
<div class="top">
  <p class="eyebrow">{{ site.eyebrow }}</p>

  <div class="videos">
    <a class="video-card" href="{{ site.videoActivationUrl }}">
      <span class="vc-play" aria-hidden="true">&#9654;</span>
      <span class="vc-label">{{ site.videoActivationLabel }}</span>
      <span class="vc-go">Watch &rarr;</span>
    </a>
    <a class="video-card alt" href="{{ site.videoInstructionsUrl }}">
      <span class="vc-play" aria-hidden="true">&#9654;</span>
      <span class="vc-label">{{ site.videoInstructionsLabel }}</span>
      <span class="vc-go">Watch &rarr;</span>
    </a>
  </div>
</div>

<section class="band">
  <h1>{{ site.homeTitle }}</h1>

  <div class="rows" style="margin-top:2rem">
  {%- set homeFaq = collections.faq | onHome | byOrder -%}
  {%- for item in homeFaq %}
    <details id="{{ item.data.anchor }}" {% if loop.first %}open{% endif %}>
      <summary>
        <span class="idx">{{ loop.index | pad }}</span>
        <span class="q">{{ item.data.title }}</span>
        <span class="sign">+</span>
      </summary>
      <div class="a">{{ item.templateContent | safe }}</div>
    </details>
  {%- endfor %}
  </div>

  <div class="actions">
    <a class="btn" href="/faq/">{{ site.seeAllLabel }}</a>
  </div>
</section>

<div class="guide-block">
  <div class="gb-head"><h2>{{ site.guideBlockTitle }}</h2></div>
  <div class="rows">
  {%- set allGuide = collections.guide | byOrder -%}
  {%- for ch in allGuide %}
    <a class="row" href="/wiki/#{{ ch.data.anchor }}">
      <span class="idx">{{ loop.index | pad }}</span>
      <span class="q">{{ ch.data.title }}</span>
      <span class="sign">&rarr;</span>
    </a>
  {%- endfor %}
  </div>
</div>

<div class="faq-bar">
  <p>{{ site.faqBarText }}</p>
  <a class="btn" href="/faq/">Read the FAQ</a>
</div>
