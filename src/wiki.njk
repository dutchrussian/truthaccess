  {%- endfor %}
  </nav>
</div>

{%- for ch in collections.guide | byOrder %}
<div class="chapter" id="{{ ch.data.anchor }}">
  <p class="eyebrow">{{ loop.index | pad }}</p>
  <h2>{{ ch.data.title }}</h2>
  {{ ch.templateContent | safe }}
</div>
{%- endfor %}
